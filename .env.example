# Fixi – Server-Konfiguration. Kopie als ".env" im Projektordner anlegen.
# Werte mit Sonderzeichen (z.B. # oder Leerzeichen) in Anführungszeichen setzen:
#   SA_PASSWORD='mein#passwort'
# In Docker/Portainer ist keine .env nötig: dieselben Namen als Umgebungsvariablen
# setzen (siehe deploy/portainer-stack.yml). HOST und PORT setzt das Image selbst.

# HTTP
PORT=5174
# 127.0.0.1 = nur lokal (hinter Reverse-Proxy empfohlen), 0.0.0.0 = alle Interfaces
HOST=127.0.0.1
# Anzahl vertrauenswürdiger Proxy-Hops (nginx/Caddy davor: 1), sonst false
TRUST_PROXY=1
# Session-Cookie nur über HTTPS senden: auto (nach X-Forwarded-Proto), true, false
COOKIE_SECURE=auto
SESSION_TTL_DAYS=30

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fixi
DB_USER=fixi
DB_PASSWORD=

# Superadmin (Login unter /sa). Die .env ist die Quelle der Wahrheit:
# ein geändertes Passwort wird beim nächsten Start übernommen.
SA_USERNAME=schick
SA_PASSWORD='bitte-aendern'
