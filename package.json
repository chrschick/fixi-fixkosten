{
  "name": "fixi",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.ts",
    "build": "yarn build:web && yarn build:server",
    "build:web": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json && esbuild server/index.ts --bundle --platform=node --target=node18 --format=esm --packages=external --outfile=dist-server/index.mjs",
    "start": "node dist-server/index.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "xlsx": "^0.18.5"
  }
}
